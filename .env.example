# Copy to .env and replace the value before starting the container.
#
# Generate a strong token:
#   openssl rand -hex 32
#
# PowerShell alternative:
#   -join ((1..32) | ForEach-Object { '{0:x2}' -f (Get-Random -Maximum 256) })
#
# The server refuses to start if this is left as the placeholder below or is
# shorter than 16 characters — set a real token before starting the container.

WAIRON_ADMIN_TOKEN=replace-with-a-random-64-hex-character-token

# Built-in super-admin WEB login (optional): uncomment BOTH to enable the
# username+password sign-in on the web UI (POST /web/login). When either is
# unset, password login is disabled and the web UI is SSO-only — the server
# still starts. This env-anchored account is the ONLY identity that may hold
# the instance-wide *:* grant; user records and minted tokens can never carry it.
# WAIRON_ADMIN_USER=admin
# WAIRON_ADMIN_PASSWORD=replace-with-a-strong-unique-password

# Declarative OIDC/SSO seeding (optional): when WAIRON_OIDC_ISSUER is set,
# startup seeds (idempotently re-seeds on every boot) the identity provider
# `default` from these values — the whole SSO setup ships in this file, no
# post-deploy clicking. The web UI still manages providers on top. Give EITHER
# the raw client secret (stored into the data-dir secret store under the ref
# "oidc-default") OR an existing stored ref via WAIRON_OIDC_CLIENT_SECRET_REF.
# List values are comma-separated.
# WAIRON_OIDC_ISSUER=https://sso.example.com/application/o/wairon/
# WAIRON_OIDC_PROVIDER_TYPE=oidc
# Login-button label: the sign-in screen shows "Sign in with <display name>";
# defaults to the provider id ("default") when unset.
# WAIRON_OIDC_DISPLAY_NAME=Corporate SSO
# WAIRON_OIDC_CLIENT_ID=wairon
# WAIRON_OIDC_CLIENT_SECRET=replace-with-the-oidc-client-secret
# WAIRON_OIDC_CLIENT_SECRET_REF=oidc-default
# WAIRON_OIDC_ADMIN_GROUPS=wairon-admins
# WAIRON_OIDC_ALLOWED_REDIRECT_URIS=https://wairon.example.com/web/sso/callback
# WAIRON_OIDC_ALLOWED_DOMAINS=example.com
# Split-horizon endpoint overrides (public authorize vs VPC-internal back-channel):
# WAIRON_OIDC_AUTHORIZATION_ENDPOINT=
# WAIRON_OIDC_TOKEN_ENDPOINT=
# WAIRON_OIDC_JWKS_URI=
# WAIRON_OIDC_USERINFO_ENDPOINT=
