{
  "name": "waffle-airon-webui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Hosted wairon web UI — React SPA bundled self-contained and served by the node host server.",
  "scripts": {
    "dev": "vite",
    "prebuild": "node ../scripts/gen-canvas-engine.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "cytoscape": "^3.34.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "typescript": "^5.5.2",
    "vite": "^5.4.6",
    "vite-plugin-singlefile": "^2.0.2"
  },
  "allowScripts": {
    "esbuild@0.21.5": true
  }
}
